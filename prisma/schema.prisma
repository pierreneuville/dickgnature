// dickgnature — schéma de données.
//
// Cible de production : Vercel Postgres (Neon) via Prisma (décision Gate 1).
// Pour S1, provider = sqlite (fallback dev local explicitement autorisé au Gate 1) afin que
// scripts/verify.sh tourne sans service externe. Bascule vers postgresql quand l'env Vercel
// (DATABASE_URL réel) est câblé — voir decisions.md.
//
// `tone` est un String et non un enum Prisma : les enums Prisma ne sont pas supportés par
// SQLite. Le domaine (fun | serious) est garanti par la couche applicative (src/lib/tone.ts
// + validation zod dans src/lib/contracts.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// `status` pilote la machine à états S3 : "draft" (aucun participant) → "sent" (participants
// invités) → "partially_signed" (au moins un a signé) → "completed" (tous ont signé). Comme
// `tone`/`mode`, c'est un String (enums Prisma non supportés sur SQLite). La valeur est dérivée
// des participants dans src/lib/contract-status.ts et persistée à chaque mutation.
model Contract {
  id           String        @id @default(cuid())
  title        String
  body         String
  tone         String        @default("fun")
  status       String        @default("draft")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  signatures   Signature[]
  participants Participant[]
}

// Participant à un contrat (S3). Signataire SANS compte : il ouvre son lien tokenisé et signe.
// `token` est un secret ≥128 bits, non devinable et unique (voir src/lib/participants.ts).
// `expiresAt` borne la durée de vie du lien (TTL simple) ; `signedAt` marque l'usage unique.
model Participant {
  id         String      @id @default(cuid())
  contractId String
  contract   Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name       String
  email      String
  token      String      @unique
  expiresAt  DateTime
  signedAt   DateTime?
  createdAt  DateTime    @default(now())
  signatures Signature[]

  @@unique([contractId, email])
  @@index([contractId])
}

// Signature apposée sur un contrat (S2). `mode` = "handwritten" (tous tons) | "pattern"
// (motif parodique, réservé au ton "fun" — garanti par la couche domaine, cf. src/lib/
// signatures.ts). L'image est un PNG en dataURL. Comme `tone`, `mode` est un String :
// enums Prisma non supportés sur SQLite (cible prod Postgres, voir decisions.md RISK-001).
model Signature {
  id            String       @id @default(cuid())
  contractId    String
  contract      Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  // Lien optionnel vers le participant qui a signé (flux tokenisé S3). Reste null pour une
  // signature apposée hors flux participant (auto-signature depuis la page contrat, S2).
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  mode          String
  image         String
  signedAt      DateTime     @default(now())

  @@index([contractId])
}
