# S1 dev: SQLite (fallback local autorisé au Gate 1). Chemin relatif au dossier prisma/.
DATABASE_URL="file:./dev.db"

# Cible de production (Gate 1) : Vercel Postgres (Neon). Basculer le provider de schema.prisma
# vers "postgresql" et renseigner l'URL fournie par Vercel quand l'env est câblé.
# DATABASE_URL="postgres://<user>:<password>@<host>/<db>?sslmode=require"

# S5 : sans clé, les emails restent hors-ligne et sont seulement journalisés (dev/test/verify).
# En production Vercel, fournir la clé Resend. Sans domaine vérifié, utiliser l'expéditeur de
# test Resend `onboarding@resend.dev` — limite : en mode test, Resend ne délivre qu'à l'adresse
# du titulaire du compte tant qu'un domaine n'est pas vérifié (cf. docs/dickgnature-deploy.md §6).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
