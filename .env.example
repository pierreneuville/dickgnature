# Base applicative (schema.prisma est en provider "postgresql").
#   - Dev/prod : URL Postgres (Vercel Postgres / Neon). DIRECT_URL = chaîne non-pooled pour les DDL.
#   - Local jetable : `docker compose up -d --wait` expose une base de test sur le port 5433.
DATABASE_URL="postgres://<user>:<password>@<host>/<db>?sslmode=require"
# DIRECT_URL="postgres://<user>:<password>@<host-non-pooled>/<db>?sslmode=require"

# Base de test reproductible pour `./scripts/verify.sh` et la suite d'intégration.
# Doit contenir « test » (garde-fou anti-prod). Défaut = base docker-compose locale ci-dessous.
# En CI, la pointer sur le service Postgres du workflow (cf. docs/dickgnature-deploy.md §2).
TEST_DATABASE_URL="postgresql://dickgnature:dickgnature@localhost:5433/dickgnature_test?sslmode=disable"

# S5 : sans clé, les emails restent hors-ligne et sont seulement journalisés (dev/test/verify).
# En production Vercel, fournir la clé Resend. Sans domaine vérifié, utiliser l'expéditeur de
# test Resend `onboarding@resend.dev` — limite : en mode test, Resend ne délivre qu'à l'adresse
# du titulaire du compte tant qu'un domaine n'est pas vérifié (cf. docs/dickgnature-deploy.md §6).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# URL publique absolue utilisée pour canonical, hreflang, sitemap, robots et données structurées.
# Garder la valeur de production sans slash final ; les previews Vercel peuvent la surcharger.
NEXT_PUBLIC_SITE_URL="https://dickgnature.vercel.app"
